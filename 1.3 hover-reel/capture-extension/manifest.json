{
  "manifest_version": 3,
  "name": "Paper Capture Tool",
  "version": "1.2.32",
  "description": "Capture navbar, dropdown, hover, and component states from a live page into Paper.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "sidePanel",
    "storage",
    "tabs",
    "windows"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Paper Capture Tool"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content/session-from-url.js"],
      "run_at": "document_start"
    }
  ]
}
